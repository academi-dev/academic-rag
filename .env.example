# Configuración de almacenamiento vectorial y embeddings
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Configuración de fragmentación de texto (chunking)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Proveedor de LLM: "local" (sin costo, usando citas directas) o "openai"
LLM_PROVIDER=local
OPENAI_API_KEY=your-key-here-if-using-openai

# Configuración del servidor y subidas
UPLOAD_DIR=./uploads
HOST=0.0.0.0
PORT=8000
DEBUG=false
